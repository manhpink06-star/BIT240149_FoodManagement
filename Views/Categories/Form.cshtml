@model CategoryFormViewModel
@{
    bool isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? T["EditCategory"] : T["CreateCategory"];
}
<div class="page-head">
    <div>
        <div class="eyebrow">BIT240149 / @T["Categories"]</div>
        <h1>@ViewData["Title"]</h1>
    </div>
    <a class="btn ghost" asp-action="Index">← @T["BackToList"]</a>
</div>
<section class="panel form-container">
    <form asp-controller="Categories" asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post">
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="All" class="validation"></div>
        <div class="field">
            <label asp-for="Name">@T["Name"] *</label>
            <input asp-for="Name" maxlength="120" required />
        </div>
        <div class="field">
            <label asp-for="Description">@T["Description"]</label>
            <textarea asp-for="Description" rows="4" maxlength="1000"></textarea>
        </div>
        <div class="form-actions">
            <button class="btn primary" type="submit">@T["Save"]</button>
            <a class="btn ghost" asp-action="Index">@T["Cancel"]</a>
        </div>
    </form>
</section>

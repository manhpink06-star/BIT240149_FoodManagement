@model DishFormViewModel
@{
    bool isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? T["EditDish"] : T["CreateDish"];
}
<div class="page-head">
    <div>
        <div class="eyebrow">BIT240149 / @T["Dishes"]</div>
        <h1>@ViewData["Title"]</h1>
    </div>
    <a class="btn ghost" asp-action="Index">← @T["BackToList"]</a>
</div>
<div class="form-container panel">
    @if (!Model.Categories.Any())
    {
        <div class="alert error">@T["NoCategories"]</div>
        <a class="btn primary" asp-controller="Categories" asp-action="Create">@T["CreateCategory"]</a>
    }
    else
    {
        <form asp-controller="Dishes" asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post">
            <input asp-for="Id" type="hidden" />
            <div asp-validation-summary="All" class="validation"></div>
            <div class="form-grid">
                <div class="field">
                    <label asp-for="Name">@T["Name"] *</label>
                    <input asp-for="Name" maxlength="150" required />
                </div>
                <div class="field">
                    <label asp-for="DishCategoryId">@T["Category"] *</label>
                    <select asp-for="DishCategoryId" asp-items="Model.Categories" required>
                        <option value="0">-- @T["Category"] --</option>
                    </select>
                </div>
                <div class="field">
                    <label asp-for="Price">@T["Price"] *</label>
                    <input asp-for="Price" type="number" min="0.01" step="0.01" value="@Model.Price.ToString(CultureInfo.InvariantCulture)" required />
                </div>
                <div class="field">
                    <label asp-for="PreparationTime">@T["PreparationTime"] *</label>
                    <input asp-for="PreparationTime" type="number" min="1" step="1" required />
                </div>
                <div class="field span-all">
                    <label asp-for="Description">@T["Description"]</label>
                    <textarea asp-for="Description" rows="4" maxlength="2000"></textarea>
                </div>
                <div class="field span-all check-field">
                    <input asp-for="IsAvailable" type="checkbox" />
                    <label asp-for="IsAvailable">@T["Available"]</label>
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn primary">@T["Save"]</button>
                <a class="btn ghost" asp-action="Index">@T["Cancel"]</a>
            </div>
        </form>
    }
</div>
